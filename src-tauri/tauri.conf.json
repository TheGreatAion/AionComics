{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AionComics",
  "mainBinaryName": "AionComics",
  "version": "1.2.0",
  "identifier": "com.aion.comics",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "AionComics",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ2NDBEQjQzODlCNUEzMjgKUldRb283V0pROXRBUm5jM3p6a3hwVEtuVUlyNnJNd09uUzZqTktBV3pMODRUcDk1MXl4VUNtQmsK",
      "endpoints": ["https://github.com/TheGreatAion/AionComics/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "fileAssociations": [
      { "ext": ["cbz", "cbr", "cb7"], "name": "Comic book", "description": "Comic book archive", "role": "Viewer" }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}